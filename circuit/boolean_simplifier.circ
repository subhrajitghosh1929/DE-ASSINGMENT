<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  This file is intended to be loaded by Logisim (http://www.cburch.com/logisim/).
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>
  <main name="main"/>
  <options/>
  <mappings/>
  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
    <tool lib="6" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
  </toolbar>

  <!-- =============================================================
       Circuit: F(A,B,C,D) = A'C + B'C + C'D'
       Minterms: Σm(0,2,3,4,6,7,8,10,11,12)
       Layout (left to right):
         [Inputs] → [NOT gates] → [AND gates] → [OR gate] → [Output]
       ============================================================= -->
  <circuit name="main">
    <a key="circuit" val="main"/>

    <!-- ══════════════════════════════
         INPUT PINS  (facing east)
         loc = wire-exit point (right side of pin)
         ══════════════════════════════ -->
    <comp lib="0" loc="(40,80)" name="Pin">
      <a key="output" val="false"/>
      <a key="label" val="A"/>
      <a key="labelloc" val="west"/>
    </comp>
    <comp lib="0" loc="(40,150)" name="Pin">
      <a key="output" val="false"/>
      <a key="label" val="B"/>
      <a key="labelloc" val="west"/>
    </comp>
    <comp lib="0" loc="(40,220)" name="Pin">
      <a key="output" val="false"/>
      <a key="label" val="C"/>
      <a key="labelloc" val="west"/>
    </comp>
    <comp lib="0" loc="(40,290)" name="Pin">
      <a key="output" val="false"/>
      <a key="label" val="D"/>
      <a key="labelloc" val="west"/>
    </comp>

    <!-- ══════════════════════════════
         NOT GATES  (facing east)
         loc = output point (right side)
         input is 30 px left of loc
         ══════════════════════════════ -->
    <comp lib="1" loc="(130,80)" name="NOT Gate">
      <a key="label" val="A&apos;"/>
      <a key="labelloc" val="north"/>
    </comp>
    <comp lib="1" loc="(130,150)" name="NOT Gate">
      <a key="label" val="B&apos;"/>
      <a key="labelloc" val="north"/>
    </comp>
    <comp lib="1" loc="(130,220)" name="NOT Gate">
      <a key="label" val="C&apos;"/>
      <a key="labelloc" val="north"/>
    </comp>
    <comp lib="1" loc="(130,290)" name="NOT Gate">
      <a key="label" val="D&apos;"/>
      <a key="labelloc" val="north"/>
    </comp>

    <!-- ══════════════════════════════
         2-INPUT AND GATES  (size=30, facing east)
         loc = output point
         top-input  = (loc.x-50, loc.y-10)
         bot-input  = (loc.x-50, loc.y+10)
         ══════════════════════════════ -->

    <!-- AND gate 1: computes A'·C → output at (270,110) -->
    <!-- top-in=(220,100)=A', bot-in=(220,120)=C         -->
    <comp lib="1" loc="(270,110)" name="AND Gate">
      <a key="inputs" val="2"/>
      <a key="size" val="30"/>
      <a key="label" val="A&apos;C"/>
      <a key="labelloc" val="north"/>
    </comp>

    <!-- AND gate 2: computes B'·C → output at (270,200) -->
    <!-- top-in=(220,190)=B', bot-in=(220,210)=C         -->
    <comp lib="1" loc="(270,200)" name="AND Gate">
      <a key="inputs" val="2"/>
      <a key="size" val="30"/>
      <a key="label" val="B&apos;C"/>
      <a key="labelloc" val="north"/>
    </comp>

    <!-- AND gate 3: computes C'·D' → output at (270,270) -->
    <!-- top-in=(220,260)=C', bot-in=(220,280)=D'         -->
    <comp lib="1" loc="(270,270)" name="AND Gate">
      <a key="inputs" val="2"/>
      <a key="size" val="30"/>
      <a key="label" val="C&apos;D&apos;"/>
      <a key="labelloc" val="north"/>
    </comp>

    <!-- ══════════════════════════════
         3-INPUT OR GATE  (size=30, facing east)
         loc = output point (380,200)
         top-input  = (330,180)  ← A'C
         mid-input  = (330,200)  ← B'C
         bot-input  = (330,220)  ← C'D'
         ══════════════════════════════ -->
    <comp lib="1" loc="(380,200)" name="OR Gate">
      <a key="inputs" val="3"/>
      <a key="size" val="30"/>
      <a key="label" val="F = A&apos;C+B&apos;C+C&apos;D&apos;"/>
      <a key="labelloc" val="north"/>
    </comp>

    <!-- ══════════════════════════════
         OUTPUT PIN  F  (facing west, receives from left)
         loc = wire-entry point (left side of pin)
         ══════════════════════════════ -->
    <comp lib="0" loc="(440,200)" name="Pin">
      <a key="output" val="true"/>
      <a key="label" val="F"/>
      <a key="labelloc" val="east"/>
    </comp>

    <!-- ══════════════════════════════════════════════════════════
         WIRES
         ══════════════════════════════════════════════════════════ -->

    <!-- ─── A, B, D  →  their respective NOT gate inputs ─── -->
    <wire from="(40,80)"   to="(100,80)"/>    <!-- A  → NOT_A in  -->
    <wire from="(40,150)"  to="(100,150)"/>   <!-- B  → NOT_B in  -->
    <wire from="(40,290)"  to="(100,290)"/>   <!-- D  → NOT_D in  -->

    <!-- ─── C pin → junction → NOT_C input (split for bus) ─── -->
    <wire from="(40,220)"  to="(60,220)"/>    <!-- C left segment  -->
    <wire from="(60,220)"  to="(100,220)"/>   <!-- C right → NOT_C in -->

    <!-- ─── A' routing: NOT_A out → AND1 top input (220,100) ─── -->
    <wire from="(130,80)"  to="(130,100)"/>   <!-- A' drop down    -->
    <wire from="(130,100)" to="(220,100)"/>   <!-- A' → AND1 in[0] -->

    <!-- ─── B' routing: NOT_B out → AND2 top input (220,190) ─── -->
    <wire from="(130,150)" to="(130,190)"/>   <!-- B' drop down    -->
    <wire from="(130,190)" to="(220,190)"/>   <!-- B' → AND2 in[0] -->

    <!-- ─── C vertical bus: feeds AND1 bot (220,120) and AND2 bot (220,210) ─── -->
    <wire from="(60,120)"  to="(60,210)"/>    <!-- C bus upper     -->
    <wire from="(60,210)"  to="(60,220)"/>    <!-- C bus lower (joins horizontal C) -->
    <wire from="(60,120)"  to="(220,120)"/>   <!-- C → AND1 in[1]  -->
    <wire from="(60,210)"  to="(220,210)"/>   <!-- C → AND2 in[1]  -->

    <!-- ─── C' routing: NOT_C out → AND3 top input (220,260) ─── -->
    <wire from="(130,220)" to="(130,260)"/>   <!-- C' drop down    -->
    <wire from="(130,260)" to="(220,260)"/>   <!-- C' → AND3 in[0] -->

    <!-- ─── D' routing: NOT_D out → AND3 bot input (220,280) ─── -->
    <wire from="(130,290)" to="(130,280)"/>   <!-- D' up 10        -->
    <wire from="(130,280)" to="(220,280)"/>   <!-- D' → AND3 in[1] -->

    <!-- ─── AND1 output → OR top input ─── -->
    <wire from="(270,110)" to="(270,180)"/>   <!-- AND1 out down   -->
    <wire from="(270,180)" to="(330,180)"/>   <!-- → OR in[0]      -->

    <!-- ─── AND2 output → OR mid input ─── -->
    <wire from="(270,200)" to="(330,200)"/>   <!-- AND2 → OR in[1] (straight) -->

    <!-- ─── AND3 output → OR bot input ─── -->
    <wire from="(270,270)" to="(270,220)"/>   <!-- AND3 out up     -->
    <wire from="(270,220)" to="(330,220)"/>   <!-- → OR in[2]      -->

    <!-- ─── OR output → F output pin ─── -->
    <wire from="(380,200)" to="(440,200)"/>   <!-- OR → F          -->

  </circuit>
</project>
